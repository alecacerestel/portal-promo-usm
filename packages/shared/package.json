{
  "name": "@portal/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos y constantes compartidos entre web y api",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
