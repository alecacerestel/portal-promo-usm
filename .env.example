# Copia este archivo a .env y ajusta los valores. .env nunca se sube a git.

# Base de datos (PostgreSQL en Docker)
POSTGRES_USER=promo
POSTGRES_PASSWORD=promo_dev
POSTGRES_DB=portal_promo
DATABASE_URL=postgresql://promo:promo_dev@localhost:5432/portal_promo

# API
API_PORT=4000
# Sesiones: genera uno propio con  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo

# Web: reenvía /api/* a esta URL
API_URL=http://localhost:4000

# Primer admin (pnpm --filter @portal/api db:seed). RUT ficticio por defecto.
# SEED_ADMIN_RUT=11.111.111-1
